{
  "project": {
    "name": "JobTracker Pro",
    "description": "Aplicación web para comprobar a que ofertas de linkedin me he inscrito y cuales me han respondido por email, con filtros y palabras clave",
    "version": "0.1.0"
  },
  "scrum": {
    "sprintDurationDays": 1,
    "maxSprints": 5,
    "autoAdvance": true,
    "reviewBeforeAdvance": true
  },
  "agents": {
    "team": [
      {
        "id": "productOwner",
        "role": "productOwner",
        "enabled": true,
        "label": "Sarah (Product Owner)"
      },
      {
        "id": "developer",
        "role": "developer",
        "enabled": true,
        "label": "Alex (Developer)"
      },
      {
        "id": "qaTester",
        "role": "qaTester",
        "enabled": true,
        "label": "María (QA)"
      },
      {
        "id": "scrumMaster",
        "role": "scrumMaster",
        "enabled": true,
        "label": "Carlos (Scrum Master)"
      }
    ],
    "backend": "claude",
    "headless": false,
    "slowMo": 100,
    "timeout": 180000,
    "sessionDir": "./sessions",
    "shareSession": true,
    "userDataDir": "",
    "local": {
      "baseUrl": "http://localhost:11434",
      "llmConnectionPreset": "ollama_local",
      "llmConnectionLabel": "",
      "apiKeyEnv": "",
      "apiKeyMode": "x-api-key",
      "generateTimeoutMs": 1200000,
      "model": "gemma3:1b",
      "embedModel": "nomic-embed-text",
      "rag": {
        "enabled": true,
        "indexPaths": [
          ".",
          "./lib",
          "./prompts",
          "./outputs"
        ],
        "topK": 5
      },
      "apiKeyHeader": "",
      "apiKeyPrefix": "",
      "apiKey": ""
    },
    "note": "backend: 'claude' | 'local'. llmConnectionPreset: ollama_local | remote_api | custom + llmConnectionLabel (texto en logs). API estilo Ollama. apiKey/apiKeyEnv opcional. RAG: ollama pull <embedModel>."
  },
  "outputs": {
    "saveArtifacts": true,
    "autoOpenDashboard": true,
    "port": 3000,
    "writeWorkingCopyEachSprint": true,
    "requireFilesEachSprint": true,
    "implementationRetryMax": 2,
    "runRealChecksEachSprint": true,
    "npmInstallEachSprint": true,
    "failSprintIfChecksFail": true,
    "nodeSyntaxCheckOnDelivery": true,
    "runNpmTestOnDelivery": true
  },
  "pipeline": {
    "ragArtifactMaxChars": 100000
  },
  "target": {
    "features": [
      "Integración Gmail para seguimiento de emails de selección",
      "Integración LinkedIn para oportunidades activas",
      "Integración InfoJobs, Indeed y Tecnoempleo",
      "Dashboard de procesos activos con estado",
      "Detección automática de respuestas de empresas",
      "Alertas de nuevas oportunidades no solicitadas",
      "Análisis de tendencias del mercado laboral",
      "Skills más demandadas en tiempo real",
      "Autenticación segura con almacenamiento local",
      "Exportación de datos a CSV/PDF"
    ],
    "techStack": {
      "frontend": "HTML5, CSS3, Vanilla JavaScript",
      "backend": "Node.js + Express",
      "database": "SQLite (local)",
      "integrations": [
        "Gmail API/IMAP",
        "LinkedIn Scraping",
        "Job Board APIs"
      ]
    }
  }
}
