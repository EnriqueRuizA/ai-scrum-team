{
  "project": {
    "name": "JobTracker Pro",
    "description": "Aplicación web para comprobar a que ofertas de linkedin me he inscrito y para cuales de ellas tengo respuesta por email y en que sentido (rechazado, interesados... etc)",
    "version": "0.1.0"
  },
  "scrum": {
    "sprintDurationDays": 1,
    "maxSprints": 5,
    "autoAdvance": true,
    "reviewBeforeAdvance": true
  },
  "agents": {
    "team": [
      {
        "id": "productOwner",
        "role": "productOwner",
        "enabled": true,
        "label": "Sarah (Product Owner)"
      },
      {
        "id": "developer",
        "role": "developer",
        "enabled": true,
        "label": "Alex (Developer)"
      },
      {
        "id": "qaTester",
        "role": "qaTester",
        "enabled": true,
        "label": "María (QA)"
      },
      {
        "id": "scrumMaster",
        "role": "scrumMaster",
        "enabled": true,
        "label": "Carlos (Scrum Master)"
      }
    ],
    "roles": [
      {
        "id": "scrumMaster",
        "label": "Carlos (Scrum Master)",
        "mission": "",
        "model": "",
        "skills": [],
        "enabled": true
      },
      {
        "id": "productOwner",
        "label": "Sarah (Product Owner)",
        "mission": "",
        "model": "",
        "skills": [],
        "enabled": true
      },
      {
        "id": "developer",
        "label": "Alex (Developer)",
        "mission": "",
        "model": "",
        "skills": [],
        "enabled": true
      },
      {
        "id": "qaTester",
        "label": "María (QA)",
        "mission": "",
        "model": "",
        "skills": [],
        "enabled": true
      }
    ],
    "flow": [
      {
        "role": "scrumMaster",
        "task": "plan"
      },
      {
        "role": "productOwner",
        "task": "refinar"
      },
      {
        "role": "developer",
        "task": "implementar"
      },
      {
        "role": "qaTester",
        "task": "probar",
        "loop": {
          "until": "qa.passed",
          "max": 3,
          "fix": {
            "role": "developer",
            "task": "implementar"
          }
        }
      },
      {
        "role": "scrumMaster",
        "task": "revisar"
      }
    ],
    "backend": "local",
    "opencode": {
      "mode": "run",
      "model": "opencode/longcat-2.5-preview-free",
      "variant": "high",
      "url": "http://127.0.0.1:4096",
      "timeoutMs": 600000,
      "auto": false
    },
    "models": [
      {
        "id": "ollama/qwen3.5:9b",
        "label": "Qwen 3.5 9B (Ollama local)"
      },
      {
        "id": "ollama/gpt-oss:20b",
        "label": "GPT-OSS 20B (Ollama local)"
      },
      {
        "id": "opencode/muse-spark-1.3-contributor-free",
        "label": "Muse Spark (opencode cloud, gratis)"
      },
      {
        "id": "opencode/big-pickle",
        "label": "opencode/big-pickle (opencode cloud)"
      },
      {
        "id": "opencode/ling-3.0-flash-fin-free",
        "label": "opencode/ling-3.0-flash-fin-free (opencode cloud)"
      },
      {
        "id": "opencode/longcat-2.5-preview-free",
        "label": "opencode/longcat-2.5-preview-free (opencode cloud)"
      },
      {
        "id": "opencode/mimo-v2.6-flash-free",
        "label": "opencode/mimo-v2.6-flash-free (opencode cloud)"
      },
      {
        "id": "opencode/nemotron-3-ultra-free",
        "label": "opencode/nemotron-3-ultra-free (opencode cloud)"
      },
      {
        "id": "opencode/nemotron-3.5-lightning-free",
        "label": "opencode/nemotron-3.5-lightning-free (opencode cloud)"
      },
      {
        "id": "opencode/space-bunny-free",
        "label": "opencode/space-bunny-free (opencode cloud)"
      }
    ],
    "rag": {
      "enabled": true,
      "indexPaths": [
        ".",
        "./src",
        "./prompts"
      ],
      "topK": 5
    },
    "headless": true,
    "slowMo": 100,
    "timeout": 180000,
    "sessionDir": "./sessions",
    "shareSession": true,
    "userDataDir": "",
    "local": {
      "baseUrl": "http://localhost:11434",
      "providerPreset": "ollama_local",
      "httpAdapter": "ollama",
      "llmConnectionPreset": "ollama_local",
      "llmConnectionLabel": "CURSOR-API",
      "apiKeyEnv": "",
      "apiKeyMode": "bearer",
      "generateTimeoutMs": 1200000,
      "model": "gpt-oss:20b",
      "embedModel": "nomic-embed-text",
      "rag": {
        "enabled": true,
        "indexPaths": [
          ".",
          "./lib",
          "./prompts",
          "./outputs"
        ],
        "topK": 5
      },
      "apiKeyHeader": "",
      "apiKeyPrefix": "",
      "apiKey": ""
    },
    "note": "backend: claude | local. providerPreset + httpAdapter (ollama | openai_compatible). OpenAI-compatible: /v1/chat/completions. Claude navegador ≠ esta API. apiKey/apiKeyEnv opcional."
  },
  "outputs": {
    "saveArtifacts": true,
    "autoOpenDashboard": true,
    "port": 3000,
    "writeWorkingCopyEachSprint": true,
    "requireFilesEachSprint": true,
    "implementationRetryMax": 2,
    "runRealChecksEachSprint": true,
    "npmInstallEachSprint": true,
    "failSprintIfChecksFail": true,
    "nodeSyntaxCheckOnDelivery": true,
    "runNpmTestOnDelivery": true
  },
  "pipeline": {
    "ragArtifactMaxChars": 100000
  },
  "target": {
    "features": [
      "Integración Gmail para seguimiento de emails de selección",
      "Integración LinkedIn para oportunidades activas",
      "Integración InfoJobs, Indeed y Tecnoempleo",
      "Dashboard de procesos activos con estado",
      "Detección automática de respuestas de empresas",
      "Alertas de nuevas oportunidades no solicitadas",
      "Análisis de tendencias del mercado laboral",
      "Skills más demandadas en tiempo real",
      "Autenticación segura con almacenamiento local",
      "Exportación de datos a CSV/PDF"
    ],
    "techStack": {
      "frontend": "HTML5, CSS3, Vanilla JavaScript",
      "backend": "Node.js + Express",
      "database": "SQLite (local)",
      "integrations": [
        "Gmail API/IMAP",
        "LinkedIn Scraping",
        "Job Board APIs"
      ]
    }
  }
}
