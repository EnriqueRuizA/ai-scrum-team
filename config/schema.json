{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-scrum-team project-config",
  "type": "object",
  "required": ["agents"],
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "scrum": {
      "type": "object",
      "properties": {
        "sprintDurationDays": { "type": "number", "minimum": 1 },
        "maxSprints": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "agents": {
      "type": "object",
      "required": ["team"],
      "properties": {
        "team": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role"],
            "properties": {
              "id": { "type": "string" },
              "role": { "type": "string", "enum": ["productOwner", "developer", "qaTester", "scrumMaster"] },
              "enabled": { "type": "boolean" },
              "label": { "type": "string" },
              "model": { "type": "string" },
              "files": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "backend": { "type": "string", "enum": ["local", "claude"] },
        "opencode": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["serve", "run"] },
            "url": { "type": "string" },
            "model": { "type": "string" },
            "timeoutMs": { "type": "number", "minimum": 1000 },
            "auto": { "type": "boolean" },
            "dir": { "type": "string" },
            "command": { "type": "string" }
          }
        },
        "timeout": { "type": "number", "minimum": 1000 },
        "sessionDir": { "type": "string" },
        "shareSession": { "type": "boolean" },
        "headless": { "type": "boolean" }
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "autoOpenDashboard": { "type": "boolean" }
      }
    }
  }
}
